# Anthropic (Phase 1)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8000
ENABLE_REFUSAL_FALLBACKS=true
JUDGE_MODEL=claude-sonnet-5

# Supabase (Phase 1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=manuals
DATABASE_URL=

# Auth (Phase 1): Supabase Auth for the pilot; company IdP later
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
AUTH_HS256_SECRET=

# API (Phase 1)
APP_ENV=development
CRON_SECRET=
SYNTHETIC_TOKEN=
USER_ID_HMAC_SECRET=
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_PER_DAY=120
MAX_TURNS_PER_CONVERSATION=20
CHAT_DISABLED=false

# Observability (Phase 1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Traces carry metadata only. Set to true (never in production) to attach question and answer text while debugging.
LANGFUSE_INCLUDE_TEXT=false
SENTRY_DSN=
